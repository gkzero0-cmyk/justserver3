{
  "name": "justserver3-wiki",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "sync:notion-assets": "node scripts/cache-notion-assets.mjs",
    "build": "npm test && npm run test:integrity && npm run build:app",
    "start": "next start",
    "optimize:notion-assets": "node scripts/optimize-notion-assets.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.ts",
    "test:production": "node scripts/verify-production.mjs",
    "test:integrity": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-repo-integrity.mjs",
    "audit:css": "node scripts/audit-css.mjs",
    "audit:static": "node scripts/audit-static.mjs",
    "test:deploy-bundle": "node scripts/build-deploy-bundle.mjs && node scripts/verify-deploy-bundle.mjs",
    "preflight": "npm test && npm run test:integrity && npm run audit:css && npm run audit:static && npm run test:deploy-bundle",
    "release:gate": "node scripts/release-gate.mjs",
    "prepare:runtime-assets": "node scripts/prepare-runtime-assets.mjs",
    "build:app": "npm run prepare:runtime-assets && next build",
    "predeploy": "npm run preflight && npm run build:app && npm run release:gate"
  },
  "dependencies": {
    "next": "16.3.6",
    "notion-client": "8.0.8",
    "notion-types": "8.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-notion-x": "8.0.8",
    "notion-utils": "8.0.8",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "sharp": "0.35.4"
  },
  "engines": {
    "node": "24.x"
  }
}
